# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Base de datos y cola
DATABASE_URL=postgres://opzy:opzy@localhost:5432/opzy
REDIS_URL=redis://localhost:6379/0

# LLM
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# Límites por conversación
MAX_AGENT_TURNS_PER_CONVERSATION=40
MAX_CONVERSATIONS_PER_VISITOR_PER_DAY=5

# Pagos
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Publicación
PUBLISH_BUCKET=
PUBLISH_BASE_DOMAIN=sitios.opzy.local
