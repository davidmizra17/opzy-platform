{
  "name": "@opzy/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cliente TypeScript generado desde el OpenAPI del backend.",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "generate": "openapi-typescript http://localhost:8000/api/schema/ -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "openapi-fetch": "^0.13.0" },
  "devDependencies": { "openapi-typescript": "^7.4.0", "typescript": "^5.6.0" }
}
