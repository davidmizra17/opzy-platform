{
  "library": "0.1.0",
  "theme": {
    "palettes": [
      "default",
      "warm",
      "night"
    ],
    "fonts": [
      "default",
      "serif"
    ],
    "radius": [
      "none",
      "sm",
      "md",
      "lg"
    ]
  },
  "sections": [
    {
      "type": "hero-split",
      "description": "Titular grande junto a una foto. Ideal para servicios, restaurantes y comercios locales. Va primero en la página.",
      "props": {
        "type": "object",
        "properties": {
          "variant": {
            "type": "string",
            "enum": [
              "image-left",
              "image-right"
            ],
            "default": "image-right"
          },
          "headline": {
            "type": "string",
            "maxLength": 80,
            "description": "Titular principal. Solo con datos del cliente."
          },
          "subheadline": {
            "type": "string",
            "maxLength": 160
          },
          "imageId": {
            "type": "string",
            "description": "ID de un asset subido por el cliente."
          },
          "cta": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 30
              },
              "action": {
                "type": "string",
                "enum": [
                  "whatsapp",
                  "call",
                  "form"
                ]
              }
            },
            "required": [
              "label",
              "action"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "headline",
          "cta"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2019-09/schema#"
      }
    },
    {
      "type": "services-grid",
      "description": "Lista de servicios o productos en tarjetas. Usar los servicios que nombró el cliente.",
      "props": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "columns": {
            "type": "number",
            "enum": [
              2,
              3
            ],
            "default": 3
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 50
                },
                "description": {
                  "type": "string",
                  "maxLength": 140
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 8
          }
        },
        "required": [
          "title",
          "items"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2019-09/schema#"
      }
    },
    {
      "type": "contact",
      "description": "Datos de contacto y horario. Solo incluir los datos que dio el cliente; los que falten se omiten.",
      "props": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 60,
            "default": "Contáctanos"
          },
          "whatsapp": {
            "type": "string",
            "maxLength": 32
          },
          "phone": {
            "type": "string",
            "maxLength": 32
          },
          "address": {
            "type": "string",
            "maxLength": 160
          },
          "hours": {
            "type": "string",
            "maxLength": 120
          }
        },
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2019-09/schema#"
      }
    }
  ]
}
